                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"START\",\n  \"parameters\": {\n    \"conveyor_speed\": 75\n  }\n}"
