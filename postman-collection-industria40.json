  "item": [
    {
      "name": "Grupo 5 - Autenticação & IAM",
      "item": [
        {
          "name": "POST Login - Gerar Token JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"carlos.engenheiro\",\n  \"password\": \"senha_segura_123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Autentica o usuário e retorna o Token JWT e a role (OPERATOR, ENGINEER, MANAGER, ADMIN)."
          }
        },
        {
          "name": "GET Me - Verificar Perfil Logado",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_engineer}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Retorna o perfil e permissões do usuário associado ao token JWT."
          }
        }
      ]
    },
    {
